FROM node:20-alpine

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./frontend/

RUN npm install --omit=dev --prefix frontend

COPY frontend ./frontend

WORKDIR /app/frontend

RUN npm run build

EXPOSE 4173

CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "4173"]

